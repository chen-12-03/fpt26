"""OptimizeAgent — knowledge-enhanced. Agent decides from tool results, not labels."""
from __future__ import annotations
import re
from typing import Any
from agent.agents.base import RunState
from agent.prompts import SYSTEM, build_prompt

_CODE_RE = re.compile(r"```(?:cpp|c\+\+|c)?\s*\n(.*?)```", re.DOTALL)
def extract_code(text): blocks=_CODE_RE.findall(text); return (blocks[0].strip()+"\n") if blocks else (text.strip()+"\n" if text.strip() else None)
def _latency(r): return r.report.latency_worst or r.report.latency_avg if (r and r.report) else None
def _report(r):
    if not r or not r.report: return "no report"
    rp=r.report; return f"Clk={rp.clock_period_ns}ns Lat={rp.latency_worst} II={rp.interval_max} LUT={rp.resources.get('LUT','?')} FF={rp.resources.get('FF','?')} DSP={rp.resources.get('DSP','?')}"
def _diagnose(r):
    if not r or not r.report: return "No synth data."
    rp=r.report; issues=[]
    if (rp.interval_max or 0)>1: issues.append(f"II={rp.interval_max}>1: check memory ports/partitioning.")
    if rp.latency_worst and rp.latency_worst>1000: issues.append(f"High latency ({rp.latency_worst}): try PIPELINE or DATAFLOW.")
    lut,ff=rp.resources.get('LUT',0) or 0, rp.resources.get('FF',0) or 0
    if ff>lut*5 and lut>100: issues.append(f"FF/LUT={ff/max(lut,1):.1f}x: over-unroll. Reduce factor.")
    return "\n".join(f"- {i}" for i in issues) if issues else "No obvious bottleneck."

class OptimizeAgent:
    def __init__(self, llm, max_rounds=5): self.llm,self.max_rounds=llm,max_rounds
    def run(self, state):
        task,server,best,best_lat=state.task,state.server,state.kernel,state.best_latency
        stag=0
        for rnd in range(1,self.max_rounds+1):
            cr=server.synth(best); state.results.append(cr)
            report,diag=_report(cr) if cr.ok else "no report",_diagnose(cr)
            state.log(f"opt r{rnd}: lat={best_lat} | {report}")
            state.log(f"opt r{rnd}: diag → {diag}")
            know=""
            try:
                from agent.knowledge import lookup_patterns, format_for_prompt
                m=lookup_patterns(task.description or "")
                know=format_for_prompt(m) if m else ""
                if know: state.log(f"opt r{rnd}: knowledge ×{len(m)}")
            except: pass
            prompt=build_prompt(task=task,current_kernel=best,best_latency=best_lat,csim_result="PASS",synth_result=report,bottleneck_hint=diag,knowledge_hint=know)
            resp=self.llm.complete(SYSTEM,prompt); cand=extract_code(resp)
            if not cand or cand.strip()==best.strip(): state.log(f"opt r{rnd}: no change — stop"); break
            cs=server.csim(cand); state.results.append(cs)
            if not cs.ok: state.log(f"opt r{rnd}: csim FAIL"); stag+=1; continue
            sr=server.synth(cand); state.results.append(sr)
            if not sr.ok: state.log(f"opt r{rnd}: synth FAIL"); stag+=1; continue
            lat=_latency(sr)
            state.log(f"opt r{rnd}: lat {best_lat}→{lat} | {_report(sr)}")
            if lat and (best_lat is None or lat<best_lat): best,best_lat,stag=cand,lat,0; state.log(f"opt r{rnd}: ACCEPTED (lat={lat})")
            else: stag+=1; state.log(f"opt r{rnd}: no improvement ({stag}/2)")
            if stag>=2: state.log("opt: 2 stagnant — stop"); break
        state.kernel,state.best_latency=best,best_lat; return state
